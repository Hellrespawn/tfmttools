// Match Rust char::is_whitespace, including non-ASCII separators.
WHITESPACE = _{ WHITE_SPACE }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }
name_start = _{ ASCII_ALPHA | "_" }
name_tail = _{ ASCII_ALPHANUMERIC | "_" }
name = @{ name_start ~ name_tail* }
tag = @{ "$" ~ name_start ~ (name_tail | "-")* }
quoted = @{ "\"" ~ ("\\\"" | "\\\\" | !("\"" | "\\") ~ ANY)* ~ "\"" }
number = @{ "-"? ~ ASCII_DIGIT* }
integer = @{ "-"? ~ ASCII_DIGIT+ ~ !name_tail }

document = { SOI ~ (argument | definition)* ~ EOI }
argument = { arg_keyword ~ name ~ ":" ~ name ~ settings? }
arg_keyword = @{ ^"arg" ~ !name_tail }
settings = { "(" ~ (setting ~ ("," ~ setting)* ~ ","?)? ~ ")" }
setting = { name ~ ":" ~ quoted }
definition = { name ~ ":" ~ (sequence | quoted) }
sequence = { "(" ~ conditional* ~ ")" }
conditional = { separator | fallback ~ (question ~ conditional ~ (":" ~ conditional)?)? }
question = _{ "?" ~ !":" }
separator = { "/" }
fallback = { formatted ~ ("?:" ~ formatted)* }
formatted = { unary ~ formatter* }
unary = { negation ~ unary | atom }
negation = { "!" }
atom = _{ tag | name | quoted | integer | sequence }
formatter = { "|" ~ name ~ width? }
width = { "(" ~ number ~ ")" }
